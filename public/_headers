# Netlify / Cloudflare Pages response headers. Keep in sync with vercel.json.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-xfob8x+9outuMdTaqvABcrhuw8NOrdlOXDfEJxPGVW8='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; media-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'

/static/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: text/plain; charset=utf-8

/og-image.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
