# Netlify / Cloudflare Pages response headers. Keep in sync with vercel.json.
#
# The JSON-LD hash below is GENERATED: `npm run seo:render` rewrites it from
# the actual text of the <script type="application/ld+json"> block in
# index.html, and `npm run seo:check` fails when either file is stale.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-QCqxmPWyb6FYH+TvnHr31QaECsRugj6YkkSGZQrdU2E='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; media-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'

/static/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=86400

# Crawler-facing files. Cached briefly and revalidated so a correction
# propagates within the hour instead of sitting in an edge cache for a day.
/robots.txt
  Cache-Control: public, max-age=3600, must-revalidate
  Content-Type: text/plain; charset=utf-8

/sitemap.xml
  Cache-Control: public, max-age=3600, must-revalidate
  Content-Type: application/xml; charset=utf-8

/llms.txt
  Cache-Control: public, max-age=3600, must-revalidate
  Content-Type: text/plain; charset=utf-8
